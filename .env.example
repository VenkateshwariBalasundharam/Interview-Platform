# ── Database (Neon or Supabase Postgres) ──
# Use the pooled URL at runtime; run migrations with the direct URL if your provider requires it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Auth ──
# Generate with: openssl rand -base64 48
JWT_SECRET=""
ADMIN_SESSION_HOURS=8
CANDIDATE_SESSION_HOURS=12

# ── Seed (used only by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_PASSWORD=""   # min 12 characters

# ── AI question generation (Phase 2) ──
# Default provider is Google Gemini (free key at aistudio.google.com). Without a key, everything else works;
# only "Generate questions" is disabled.
GEMINI_API_KEY=""
# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=""
# Optional: switch to Claude instead (needs a paid key from console.anthropic.com).
# LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""

# ── AI grading (Phase 4) ──
# Grading uses the same key as question generation. By default an AI-graded score can flag a candidate for
# human review but never disqualify them on its own. Set to "true" to let AI-graded rounds disqualify as configured.
# AI_GRADING_CAN_DISQUALIFY=false

# ── Resume files (Phase 2b) ──
# Optional. Folder for private resume files. Defaults to .private-storage in the project folder.
# STORAGE_DIR=""

# ── Later phases (not used yet) ──
# JUDGE0_URL=
# JUDGE0_API_KEY=
# STORAGE_PROVIDER=             # supabase | vercel-blob

# ── Coding round (Phase 5) ──
# Judge0 runs candidates' code. Point this at your own Judge0 server, or a hosted one.
# JUDGE0_URL="http://localhost:2358"
# Only if your Judge0 needs a key: RapidAPI needs both the key and host; a self-hosted one with an auth token needs only the key.
# JUDGE0_API_KEY=""
# JUDGE0_API_HOST=""
# Only if your Judge0 build numbers languages differently (check GET /languages on it). Defaults are Judge0 CE 1.13.
# JUDGE0_LANGUAGE_IDS='{"python":71,"javascript":63,"java":62,"cpp":54,"c":50,"go":60}'

# ── Face checks (Phase 6, server side) ──
# Required for face checks: 32 random bytes, base64. Generate with: openssl rand -base64 32
# FACE_ENCRYPTION_KEY=""
# Days snapshots and face references are kept before `npm run purge` removes them (default 30).
# RETENTION_DAYS=30
# Face distance above which two faces count as different people (default 0.6).
# FACE_MATCH_THRESHOLD=0.6

# ── Diagnosing slow pages ──
# Set to 1 to print how long every database query takes in the terminal (turn off again afterwards).
# PRISMA_QUERY_LOG=1

# ── Background sweep (auto-submit expired rounds, finish stuck grading) ──
# Secret the scheduler sends as `Authorization: Bearer <value>` to /api/cron/sweep. 16+ characters. Generate: openssl rand -base64 24
# On Vercel, setting CRON_SECRET makes Vercel Cron send it automatically. Without it the route stays closed.
# CRON_SECRET=""

# ── Candidate emails (login invitations, "selected for the next round", "result is ready", reminders) ──
# Without these, email stays off and everything else works: the Candidates page shows what is missing.
# The public address candidates open, no trailing slash. Every email links to <APP_URL>/login?code=<Candidate ID>.
# APP_URL="https://interview.example.com"
# Any SMTP provider works (Gmail app password, Brevo, Mailgun, SendGrid, Amazon SES, your own server).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"               # 587 (STARTTLS, default) or 465 (TLS)
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Hiring Team <hiring@example.com>"
# EMAIL_REPLY_TO="hiring@example.com"
# Development only: print emails in the terminal instead of sending them (refused in production).
# EMAIL_DRIVER="console"
# Reminders go to candidates who were invited and have not started any round.
# EMAIL_REMINDERS="on"          # "off" disables reminders
# REMINDER_AFTER_HOURS="48"     # wait after the invitation before the first reminder
# REMINDER_EVERY_HOURS="48"     # wait between reminders
# REMINDER_MAX="2"              # most reminders one candidate gets (0 = none)
